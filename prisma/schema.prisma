// MIND ARENA — database schema. See docs/06_DATABASE_DESIGN.md for the rationale behind
// non-obvious choices (Json columns, append-only ledger, derived winRate, etc).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums (mirrors src/domain/enums)
// ---------------------------------------------------------------------------

enum TournamentStatus {
  RECRUITING
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  WAITING
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ParticipantType {
  HUMAN
  BOT
}

enum ParticipantStatus {
  ACTIVE
  ELIMINATED
  BYE
  WITHDRAWN
}

enum GameSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum BotDifficulty {
  EASY
  NORMAL
  HARD
  EXPERT
  MASTER
}

enum BotPersonality {
  RANDOM
  CAUTIOUS
  AGGRESSIVE
  BETRAYER
  PATTERN
  ANALYST
}

enum PointReason {
  TOURNAMENT_ENTRY
  ROUND_1_CLEAR
  ROUND_2_CLEAR
  QUARTERFINAL_CLEAR
  SEMIFINAL_CLEAR
  RUNNER_UP
  CHAMPION
  ACHIEVEMENT_BONUS
  DAILY_BONUS
  ADMIN_ADJUSTMENT
}

enum CosmeticCategory {
  FRAME
  TITLE
  BACKGROUND
  BADGE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum FriendChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  /** Set on 退会 (account deletion) instead of a hard row delete — username/email/passwordHash
   * are scrubbed at the same time (see features/auth/deactivate-account.service.ts) so the
   * original identifiers free up for re-registration, while this row and its PlayerProfile stay
   * in place for other players' match/friend history referential integrity. authorize() in
   * auth.ts rejects login once this is set. */
  deletedAt     DateTime?

  profile PlayerProfile?

  @@map("users")
}

/** お問い合わせ (contact/support inquiries) — no outbound email is configured for this project,
 * so submissions are simply persisted here for manual review rather than emailed. */
model Inquiry {
  id        String   @id @default(cuid())
  userId    String?
  category  String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@map("inquiries")
}

model PlayerProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName          String
  totalPoints          Int      @default(0)
  prizeCurrency        Int      @default(0)
  /** Cumulative prizeCurrency ever earned (never decremented by shop purchases) — "生涯獲得賞金". */
  lifetimePrizeCurrency Int     @default(0)
  currentLeagueId      String
  currentLeague        League   @relation(fields: [currentLeagueId], references: [id])
  totalMatches         Int      @default(0)
  totalWins            Int      @default(0)
  totalLosses          Int      @default(0)
  currentWinStreak     Int      @default(0)
  bestWinStreak        Int      @default(0)
  tournamentEntries    Int      @default(0)
  tournamentWins       Int      @default(0)
  finalsReached        Int      @default(0)
  selectedTitleId      String?
  selectedFrameId      String?
  selectedBackgroundId String?
  selectedBadgeId      String?
  selectedAvatarIconId String?
  /** A user-uploaded avatar photo, stored as a small base64 data URI (client resizes/compresses
   * to a square thumbnail before upload — no object storage is configured for this app yet).
   * Takes priority over selectedAvatarIconId when set. */
  customAvatarUrl      String?
  showBotTag           Boolean  @default(true)
  reducedMotion        Boolean  @default(false)
  soundEnabled         Boolean  @default(true)
  bgmEnabled           Boolean  @default(true)
  vibrationEnabled     Boolean  @default(true)
  /** 1-7, cycling — day 7 pays the biggest reward then wraps back to day 1 (config/daily-bonus.ts).
   * Resets to 0 (next claim starts the cycle at day 1) if a calendar day (JST) is missed. */
  loginBonusStreak         Int       @default(0)
  lastLoginBonusClaimedAt  DateTime?
  /** JST date key (YYYY-MM-DD) the two counters below are counting FOR — a mismatch against
   * "today" means they're stale from a previous day and read as 0 (lazy reset, no cron job;
   * see features/daily-missions/daily-missions.service.ts). */
  dailyMissionDate     String?
  dailyMatchesPlayed   Int      @default(0)
  dailyWins            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  pointTransactions    PointTransaction[]
  gameStats            PlayerGameStats[]
  achievements         PlayerAchievement[]
  tournamentEntriesRel TournamentParticipant[]
  friendshipsSent      Friendship[]            @relation("FriendshipRequester")
  friendshipsReceived  Friendship[]            @relation("FriendshipAddressee")
  leagueTrophies       LeagueTrophy[]
  cosmeticPurchases    CosmeticPurchase[]
  challengesSent       FriendChallenge[]       @relation("ChallengeSent")
  challengesReceived   FriendChallenge[]       @relation("ChallengeReceived")
  tournamentInvitesSent     TournamentInvite[]  @relation("TournamentInviteSent")
  tournamentInvitesReceived TournamentInvite[]  @relation("TournamentInviteReceived")
  blocksMade                Block[]             @relation("BlockerOf")
  blocksReceived            Block[]             @relation("BlockedBy")
  dailyMissionClaims        DailyMissionClaim[]

  @@index([totalPoints])
  @@map("player_profiles")
}

/**
 * A one-directional block, doubling as a lightweight report (`reason` is optional free text for
 * the blocker's own context — no moderation queue reads it yet, this project has no admin panel).
 * Checked from both directions wherever a blocked pair could otherwise interact (see
 * features/friends/block.service.ts) — blocking is symmetric in effect even though the row itself
 * only has one direction.
 */
model Block {
  id        String        @id @default(cuid())
  blockerId String
  blocker   PlayerProfile @relation("BlockerOf", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   PlayerProfile @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime      @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

/** One row per (player, mission, day) claimed — the source of truth for "already claimed today"
 * and the race-safety guard for claiming (see features/daily-missions/daily-missions.service.ts).
 * `claimedForDate` is a JST date key (YYYY-MM-DD), matching PlayerProfile.dailyMissionDate. */
model DailyMissionClaim {
  id              String        @id @default(cuid())
  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  missionCode     String
  claimedForDate  String
  createdAt       DateTime      @default(now())

  @@unique([playerProfileId, missionCode, claimedForDate])
  @@map("daily_mission_claims")
}

/**
 * One row per league a player has ever won a tournament in; `count` accumulates repeat wins.
 */
model LeagueTrophy {
  id              String        @id @default(cuid())
  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  leagueId        String
  league          League        @relation(fields: [leagueId], references: [id])
  count           Int           @default(1)
  firstWonAt      DateTime      @default(now())
  lastWonAt       DateTime      @default(now()) @updatedAt

  @@unique([playerProfileId, leagueId])
  @@map("league_trophies")
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   PlayerProfile    @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   PlayerProfile    @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}

/**
 * A 1-on-1 challenge between two friends. Accepting creates a 2-player Tournament (maxPlayers=2)
 * that reuses the normal bracket/match/session/points machinery — round 1 is also the final.
 */
model FriendChallenge {
  id           String                @id @default(cuid())
  challengerId String
  challenger   PlayerProfile         @relation("ChallengeSent", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId   String
  opponent     PlayerProfile         @relation("ChallengeReceived", fields: [opponentId], references: [id], onDelete: Cascade)
  status       FriendChallengeStatus @default(PENDING)
  tournamentId String?               @unique
  tournament   Tournament?           @relation(fields: [tournamentId], references: [id])
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([challengerId, opponentId])
  @@index([opponentId, status])
  @@index([challengerId, status])
  @@map("friend_challenges")
}

// ---------------------------------------------------------------------------
// Master data (source spec §7, §33 — manageable, never hardcoded in components)
// ---------------------------------------------------------------------------

model League {
  id                  String        @id @default(cuid())
  code                String        @unique
  name                String
  displayName         String
  description         String
  requiredPoints      Int
  rewardMultiplier    Float         @default(1.0)
  championReward      Int           @default(0)
  runnerUpReward      Int           @default(0)
  topFourReward       Int           @default(0)
  participationReward Int           @default(0)
  botDifficulty       BotDifficulty
  themeKey            String
  frameKey            String
  displayOrder        Int
  isActive            Boolean       @default(true)

  profiles    PlayerProfile[]
  tournaments Tournament[]
  trophies    LeagueTrophy[]

  @@index([displayOrder])
  @@map("leagues")
}

model GameType {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  description   String
  minPlayers    Int
  maxPlayers    Int
  configuration Json    @default("{}")
  isActive      Boolean @default(true)

  matches     TournamentMatch[]
  sessions    GameSession[]
  playerStats PlayerGameStats[]

  @@map("game_types")
}

model BotProfile {
  id            String         @id @default(cuid())
  name          String
  personality   BotPersonality
  difficulty    BotDifficulty
  judgment      Int
  deception     Int
  observation   Int
  riskTolerance Int
  memory        Int
  randomness    Int
  avatarKey     String
  isActive      Boolean        @default(true)

  participations TournamentParticipant[]

  @@index([difficulty])
  @@map("bot_profiles")
}

model Achievement {
  id             String  @id @default(cuid())
  code           String  @unique
  name           String
  description    String
  conditionType  String
  conditionValue Int
  rewardData     Json    @default("{}")
  isActive       Boolean @default(true)

  unlocks PlayerAchievement[]

  @@map("achievements")
}

model CosmeticItem {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  category       CosmeticCategory
  requiredPoints Int
  /**
   * Non-null makes this item purchasable in the shop for this many prizeCurrency, independent
   * of requiredPoints (which stays the free auto-unlock threshold for FRAME/TITLE items).
   */
  price          Int?
  assetKey       String
  effectConfig   Json             @default("{}")
  isActive       Boolean          @default(true)

  purchases CosmeticPurchase[]

  @@map("cosmetic_items")
}

/**
 * Ownership record for an item bought in the shop with prizeCurrency (source: tournament wins).
 */
model CosmeticPurchase {
  id              String        @id @default(cuid())
  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  cosmeticItemId  String
  cosmeticItem    CosmeticItem  @relation(fields: [cosmeticItemId], references: [id])
  purchasedAt     DateTime      @default(now())

  @@unique([playerProfileId, cosmeticItemId])
  @@map("cosmetic_purchases")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("announcements")
}

// ---------------------------------------------------------------------------
// Tournament
// ---------------------------------------------------------------------------

model Tournament {
  id                  String           @id @default(cuid())
  leagueId            String
  league              League           @relation(fields: [leagueId], references: [id])
  status              TournamentStatus @default(RECRUITING)
  maxPlayers          Int              @default(32)
  currentRound        Int              @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  winnerParticipantId String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  participants    TournamentParticipant[]
  matches         TournamentMatch[]
  friendChallenge FriendChallenge?
  invites         TournamentInvite[]

  @@index([leagueId, status])
  @@map("tournaments")
}

enum TournamentInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

/**
 * Sent when a player joins a tournament (or opens a friend-only lobby) to friends who are
 * eligible to play in that league (same league, or a higher one — see
 * features/tournaments/invite.service.ts). The tournament stays RECRUITING and skips the
 * usual instant BOT-fill while invites are pending, giving invitees a real window to join the
 * SAME bracket instead of each starting their own solo BOT-filled tournament.
 */
model TournamentInvite {
  id           String                 @id @default(cuid())
  tournamentId String
  tournament   Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  inviterId    String
  inviter      PlayerProfile          @relation("TournamentInviteSent", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId    String
  invitee      PlayerProfile          @relation("TournamentInviteReceived", fields: [inviteeId], references: [id], onDelete: Cascade)
  status       TournamentInviteStatus @default(PENDING)
  createdAt    DateTime               @default(now())

  @@unique([tournamentId, inviteeId])
  @@index([inviteeId, status])
  @@map("tournament_invites")
}

model TournamentParticipant {
  id              String            @id @default(cuid())
  tournamentId    String
  tournament      Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerId        String?
  player          PlayerProfile?    @relation(fields: [playerId], references: [id])
  botId           String?
  bot             BotProfile?       @relation(fields: [botId], references: [id])
  type            ParticipantType
  displayName     String
  seed            Int
  status          ParticipantStatus @default(ACTIVE)
  eliminatedRound Int?
  finalPlacement  Int?

  matchesAsPlayer1 TournamentMatch[] @relation("MatchPlayer1")
  matchesAsPlayer2 TournamentMatch[] @relation("MatchPlayer2")
  matchesWon       TournamentMatch[] @relation("MatchWinner")
  gameActions      GameAction[]

  @@unique([tournamentId, playerId])
  @@index([tournamentId, status])
  @@map("tournament_participants")
}

model TournamentMatch {
  id                   String                 @id @default(cuid())
  tournamentId         String
  tournament           Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round                Int
  matchNumber          Int
  player1ParticipantId String?
  player1              TournamentParticipant? @relation("MatchPlayer1", fields: [player1ParticipantId], references: [id])
  player2ParticipantId String?
  player2              TournamentParticipant? @relation("MatchPlayer2", fields: [player2ParticipantId], references: [id])
  winnerParticipantId  String?
  winner               TournamentParticipant? @relation("MatchWinner", fields: [winnerParticipantId], references: [id])
  gameTypeId           String
  gameType             GameType               @relation(fields: [gameTypeId], references: [id])
  status               MatchStatus            @default(WAITING)
  startedAt            DateTime?
  completedAt          DateTime?

  session GameSession?
  result  MatchResult?

  @@index([tournamentId, round])
  @@map("tournament_matches")
}

// ---------------------------------------------------------------------------
// Live game session
// ---------------------------------------------------------------------------

model GameSession {
  id                String            @id @default(cuid())
  tournamentMatchId String            @unique
  tournamentMatch   TournamentMatch   @relation(fields: [tournamentMatchId], references: [id], onDelete: Cascade)
  gameTypeId        String
  gameType          GameType          @relation(fields: [gameTypeId], references: [id])
  status            GameSessionStatus @default(ACTIVE)
  currentRound      Int               @default(1)
  state             Json
  startedAt         DateTime          @default(now())
  completedAt       DateTime?

  actions GameAction[]

  @@map("game_sessions")
}

model GameAction {
  id            String                @id @default(cuid())
  gameSessionId String
  gameSession   GameSession           @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  participantId String
  participant   TournamentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  round         Int
  actionType    String
  actionData    Json
  createdAt     DateTime              @default(now())

  @@index([gameSessionId, round])
  @@map("game_actions")
}

model MatchResult {
  id                  String          @id @default(cuid())
  tournamentMatchId   String          @unique
  tournamentMatch     TournamentMatch @relation(fields: [tournamentMatchId], references: [id], onDelete: Cascade)
  winnerParticipantId String?
  loserParticipantId  String?
  player1Score        Int
  player2Score        Int
  resultData          Json
  createdAt           DateTime        @default(now())

  @@map("match_results")
}

// ---------------------------------------------------------------------------
// Growth / rewards
// ---------------------------------------------------------------------------

model PointTransaction {
  id              String        @id @default(cuid())
  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  amount          Int
  reason          PointReason
  tournamentId    String?
  leagueId        String?
  balanceBefore   Int
  balanceAfter    Int
  createdAt       DateTime      @default(now())

  @@index([playerProfileId, createdAt])
  @@map("point_transactions")
}

model PlayerGameStats {
  id              String        @id @default(cuid())
  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  gameTypeId      String
  gameType        GameType      @relation(fields: [gameTypeId], references: [id])
  matches         Int           @default(0)
  wins            Int           @default(0)
  losses          Int           @default(0)
  updatedAt       DateTime      @updatedAt

  @@unique([playerProfileId, gameTypeId])
  @@map("player_game_stats")
}

model PlayerAchievement {
  id              String        @id @default(cuid())
  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  achievementId   String
  achievement     Achievement   @relation(fields: [achievementId], references: [id])
  unlockedAt      DateTime      @default(now())
  /** Null until the client has shown the unlock celebration for it once (see
   * features/achievements/notify.service.ts) — decoupled from which match triggered the
   * unlock so it still surfaces even if the player closes the app before seeing it. */
  notifiedAt      DateTime?

  @@unique([playerProfileId, achievementId])
  @@map("player_achievements")
}
