# Copy this file to .env and fill in real values for local development.
# See README.md "セットアップ方法" for details.

# PostgreSQL connection string (Neon in production, local Postgres in dev).
# In production, use Neon's POOLED connection string (host has a "-pooler" suffix in the Neon
# console) rather than the direct one — it routes through PgBouncer so multiple app instances/
# processes don't each consume DATABASE_POOL_MAX connections against Neon's own connection cap.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mindarena_dev?schema=public"

# Max connections this process's pg Pool opens (infrastructure/database/prisma.ts). Default (5) is
# sized for Vercel serverless, where many function instances can run concurrently — each instance
# gets its own small pool, and Neon's pooled connection string fans them out via PgBouncer. Raise
# this only for a long-running (non-serverless) single-process deploy.
# DATABASE_POOL_MAX="5"

# Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Dev/E2E-only flag. Enables a deterministic auto-win mode used solely by the Playwright E2E
# suite. Server-side code refuses to honor this outside development/test regardless of this
# value — see docs/12_SECURITY.md and docs/13_TEST_PLAN.md.
NEXT_PUBLIC_E2E_TEST_MODE="false"
